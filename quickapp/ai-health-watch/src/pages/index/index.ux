  width: 100%;
  height: 50px;
  background-color: #1a1a1a;
  border-radius: 10px;
  margin-bottom: 8px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-left: 10px;
  padding-right: 10px;
}

.label-text {
  font-size: 12px;
  color: #9ca3af;
  font-weight: 400;
}

.data-right {
  flex-direction: row;
  align-items: center;
}

.data-text {
  font-size: 16px;
  color: #ffffff;
  font-weight: 600;
}

.data-unit {
  font-size: 10px;
  color: #6b7280;
  font-weight: 400;
  margin-left: 2px;
}

.status-tag {
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 8px;
  margin-left: 6px;
}

.status-tag.normal {
  color: #22c55e;
  background-color: rgba(34, 197, 94, 0.15);
}

.status-tag.fast {
  color: #ef4444;
  background-color: rgba(239, 68, 68, 0.15);
}

.status-tag.slow {
  color: #3b82f6;
  background-color: rgba(59, 130, 246, 0.15);
}

.ai-card {
  width: 100%;
  background-color: #0f2b1a;
  border-radius: 10px;
  margin-top: 2px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 10px 12px;
}

.ai-label {
  font-size: 12px;
  color: #88d8a8;
  font-weight: 600;
  margin-bottom: 4px;
}

.ai-text {
  font-size: 11px;
  color: #ffffff;
  line-height: 16px;
}

.button-card {
  width: 100%;
  height: 40px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  margin-bottom: 7px;
}

.button-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: 500;
}

.detail-btn {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  margin-top: 4px;
}

.report-btn {
  background: linear-gradient(135deg, #f97316, #ea580c);
}

.refresh-btn {
  background: linear-gradient(135deg, #22c55e, #16a34a);
}

.about-btn {
  background: linear-gradient(135deg, #52525b, #3f3f46);
  margin-top: 4px;
}


</style>
