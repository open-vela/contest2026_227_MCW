<template>
  <div class="page">
    <scroll class="scroll-content" scroll-y="true">
      <text class="title">
        健康详情
      </text>

      <div class="info-card">
        <text class="info-title">
          ❤️ 心率监测
        </text>
        <div class="heart-data-row">
          <text class="info-data">
            {{heartRate}} <text class="data-unit">bpm</text>
          </text>
          <text class="status-tag {{heartStatus}}">
            {{heartStatusText}}
          </text>
        </div>
        <text class="info-desc">
          实时监测中
        </text>
      </div>

      <div class="info-card">
        <text class="info-title">
          🚶 运动步数
        </text>
        <text class="info-data">
          {{steps}} <text class="data-unit">步</text>
        </text>
        <text class="info-desc">
          今日累计
        </text>
      </div>

      <div class="info-card">
        <text class="info-title">
          😴 睡眠时长
        </text>
        <text class="info-data">
          {{sleepDuration}} <text class="data-unit">小时</text>
        </text>
        <text class="info-desc">
          昨晚睡眠
        </text>
      </div>

      <div class="info-card">
        <text class="info-title">
          🏃 运动强度
        </text>
        <text class="info-data">
          {{sportIntensity}}
        </text>
        <text class="info-desc">
          {{fatigueTip}}
        </text>
      </div>

      <div class="info-card">
        <text class="info-title">
          📊 健康评分
        </text>
        <div class="score-row">
          <text class="info-data">
            {{healthScore}} <text class="data-unit">分</text>
          </text>
          <text class="score-tag {{healthScoreLevel}}">
            {{healthScoreLevelText}}
          </text>
        </div>
        <text class="info-desc">
          综合状态评估
        </text>
      </div>

      <div class="ai-card">
        <text class="ai-title">
          🤖 AI健康建议
        </text>
        <text class="ai-text">
          {{aiSuggestion}}
        </text>
      </div>

      <div class="back-button" @click="backHome">
        <text class="back-text">
          返回首页
        </text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import healthMock from '../../common/health.js'

export default {
  data: {
    heartRate: 65,
    steps: 0,
    sleepDuration: 0,
    sleepQuality: 0,
    sportIntensity: "",
    fatigueTip: "",
    healthScore: 0,
    aiSuggestion: "",
    heartTimer: null
  },

  computed: {
    heartStatus() {
      const rate = Number(this.heartRate) || 70
      if (rate < 60) return 'slow'
      if (rate > 100) return 'fast'
      return 'normal'
    },
    heartStatusText() {
      const rate = Number(this.heartRate) || 70
      if (rate < 60) return '偏慢'
      if (rate > 100) return '偏快'
      return '正常'
    },
    healthScoreLevel() {
      const score = Number(this.healthScore) || 0
      if (score >= 85) return 'excellent'
      if (score >= 70) return 'good'
      return 'normal'
    },
    healthScoreLevelText() {
      const score = Number(this.healthScore) || 0
      if (score >= 85) return '优秀'
      if (score >= 70) return '良好'
      return '一般'
    }
  },

  onInit() {
    // 第一层兜底：尝试读取全局数据
    let baseData = null
    try {
      baseData = healthMock.getCurrentData()
    } catch (e) {
      baseData = null
    }

    // 全局数据无效，则自动初始化一次，保证有数据显示
    if (!baseData || !baseData.steps || baseData.steps === 0) {
      healthMock.initApp((data) => {
        this.fillData(data)
        this.tryUsePageParams()
        this.startHeartBeat()
      })
    } else {
      this.fillData(baseData)
      this.tryUsePageParams()
      this.startHeartBeat()
    }
  },

  // 统一填充数据的方法，避免重复代码
  fillData(data) {
    this.heartRate = Number(data.heartRate) || 65
    this.steps = Number(data.steps) || 0
    this.sleepDuration = Number(data.sleepDuration) || 0
    this.sleepQuality = Number(data.sleepQuality) || 0
    this.sportIntensity = data.sportIntensity || ""
    this.fatigueTip = data.fatigueTip || ""
    this.healthScore = Number(data.healthScore) || 0
    this.aiSuggestion = data.aiSuggestion || ""
  },

  // 尝试使用首页传递的参数，只有合法值才覆盖
  tryUsePageParams() {
    const paramsData = this.$page.params && this.$page.params.healthData
    if (!paramsData) return

    try {
      const pageData = JSON.parse(paramsData)

      const passHeart = Number(pageData.heartRate)
      if (!isNaN(passHeart) && passHeart > 50) {
        this.heartRate = passHeart
      }
      const passSteps = Number(pageData.steps)
      if (!isNaN(passSteps) && passSteps > 0) {
        this.steps = passSteps
      }
      const passSleep = Number(pageData.sleepDuration)
      if (!isNaN(passSleep) && passSleep > 0) {
        this.sleepDuration = passSleep
      }
      if (pageData.sportIntensity && pageData.sportIntensity.length > 0) {
        this.sportIntensity = pageData.sportIntensity
      }
      if (pageData.fatigueTip && pageData.fatigueTip.length > 0) {
        this.fatigueTip = pageData.fatigueTip
      }
      const passScore = Number(pageData.healthScore)
      if (!isNaN(passScore) && passScore > 0) {
        this.healthScore = passScore
      }
      if (pageData.aiSuggestion && pageData.aiSuggestion.length > 0) {
        this.aiSuggestion = pageData.aiSuggestion
      }
    } catch (e) {
      console.log("参数解析失败，使用本地数据")
    }
  },

  onDestroy() {
    if (this.heartTimer) {
      clearInterval(this.heartTimer)
      this.heartTimer = null
    }
  },

  startHeartBeat() {
    if (this.heartTimer) {
      clearInterval(this.heartTimer)
    }
    this.heartTimer = setInterval(() => {
      let current = Number(this.heartRate)
      if (isNaN(current) || current <= 0) {
        this.heartRate = 65
        current = 65
      }
      let offset = Math.floor(Math.random() * 5) - 2
      let newRate = current + offset
      if (newRate < 60) newRate = 60
      if (newRate > 100) newRate = 100
      this.heartRate = newRate
    }, 2000)
  },

  backHome() {
    router.back()
  }
}
</script>


