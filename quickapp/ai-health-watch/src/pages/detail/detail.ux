  font-size: 11px;
  color: #6b7280;
  font-weight: 400;
}

.status-tag,
.score-tag {
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 8px;
  margin-left: 6px;
}

.status-tag.normal {
  color: #22c55e;
  background-color: rgba(34, 197, 94, 0.15);
}

.status-tag.fast {
  color: #ef4444;
  background-color: rgba(239, 68, 68, 0.15);
}

.status-tag.slow {
  color: #3b82f6;
  background-color: rgba(59, 130, 246, 0.15);
}

.score-tag.good {
  color: #f59e0b;
  background-color: rgba(245, 158, 11, 0.15);
}

.status-tag.normal {
  color: #22c55e;
  background-color: rgba(34, 197, 94, 0.15);
}


.info-desc {
  font-size: 11px;
  color: #6b7280;
  margin-top: 2px;
}

.ai-card {
  width: 100%;
  background-color: #0f2b1a;
  border-radius: 10px;
  margin-top: 12px;
  padding: 12px;
  flex-direction: column;
  align-items: center;
}

.ai-title {
  font-size: 13px;
  color: #88d8a8;
  font-weight: 600;
}

.ai-text {
  font-size: 12px;
  color: #ffffff;
  margin-top: 4px;
  text-align: center;
  line-height: 17px;
}

.back-button {
  width: 100%;
  height: 42px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border-radius: 21px;
  margin-top: 16px;
  justify-content: center;
  align-items: center;
}

.back-text {
  font-size: 15px;
  color: #ffffff;
  font-weight: 500;
}
</style>

