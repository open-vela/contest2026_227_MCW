<template>
  <div class="page">
    <scroll class="scroll-content" scroll-y="true">
      <text class="title">
        健康趋势报告
      </text>

      <div class="stat-card">
        <text class="stat-label">
          平均心率
        </text>
        <div class="stat-row">
          <text class="stat-value">
            {{avgHeartRate}} <text class="stat-unit">bpm</text>
          </text>
          <text class="status-tag {{avgHeartStatus}}">
            {{avgHeartStatusText}}
          </text>
        </div>
      </div>

      <div class="stat-card">
        <text class="stat-label">
          7天累计步数
        </text>
        <text class="stat-value">
          {{totalSteps}} <text class="stat-unit">步</text>
        </text>
      </div>

      <div class="stat-card">
        <text class="stat-label">
          平均健康评分
        </text>
        <text class="stat-value">
          {{avgHealthScore}} <text class="stat-unit">分</text>
        </text>
      </div>

      <div class="summary-card">
        <text class="summary-title">
          📋 AI周度总结
        </text>
        <text class="summary-text">
          {{summary}}
        </text>
      </div>

      <div class="back-button" @click="backHome">
        <text class="back-text">
          返回首页
        </text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import health from '../../common/health.js'

export default {
  data: {
    avgHeartRate: 0,
    totalSteps: 0,
    avgHealthScore: 0,
    summary: ""
  },

  computed: {
    avgHeartStatus() {
      if (this.avgHeartRate < 60) return 'slow'
      if (this.avgHeartRate > 100) return 'fast'
      return 'normal'
    },
    avgHeartStatusText() {
      if (this.avgHeartRate < 60) return '偏慢'
      if (this.avgHeartRate > 100) return '偏快'
      return '正常'
    }
  },

  onInit() {
    health.getWeekReport((report) => {
      this.avgHeartRate = report.avgHeartRate
      this.totalSteps = report.totalSteps
      this.avgHealthScore = report.avgHealthScore
      this.summary = report.summary
    })
  },

  backHome() {
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  padding-left: 36px;
  padding-right: 36px;
}

.scroll-content {
  width: 100%;
  flex-direction: column;
  align-items: center;
  padding-top: 12px;
  padding-bottom: 16px;
}

.title {
  font-size: 22px;
  color: #ffffff;
  margin-bottom: 10px;
  font-weight: bold;
  text-align: center;
}

.stat-card {
  width: 100%;
  background-color: #1a1a1a;
  border-radius: 10px;
  margin-top: 8px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 10px;
  padding-bottom: 10px;
}

.stat-label {
  font-size: 12px;
  color: #9ca3af;
}

.stat-row {
  flex-direction: row;
  align-items: center;
  margin-top: 3px;
}

.stat-value {
  font-size: 20px;
  color: #ffffff;
  font-weight: 600;
}

.stat-unit {
  font-size: 11px;
  color: #6b7280;
  font-weight: 400;
}

.status-tag {
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 8px;
  margin-left: 6px;
}

.status-tag.normal {
  color: #22c55e;
  background-color: rgba(34, 197, 94, 0.15);
}

.status-tag.fast {
  color: #ef4444;
  background-color: rgba(239, 68, 68, 0.15);
}

.status-tag.slow {
  color: #3b82f6;
  background-color: rgba(59, 130, 246, 0.15);
}

.summary-card {
  width: 100%;
  background-color: #0f2b1a;
  border-radius: 10px;
  margin-top: 12px;
  padding: 12px;
  flex-direction: column;
}

.summary-title {
  font-size: 13px;
  color: #88d8a8;
  margin-bottom: 8px;
  text-align: center;
  font-weight: 600;
}

.summary-text {
  font-size: 12px;
  color: #ffffff;
  line-height: 18px;
}

.back-button {
  width: 100%;
  height: 42px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border-radius: 21px;
  margin-top: 16px;
  justify-content: center;
  align-items: center;
}

.back-text {
  font-size: 15px;
  color: #ffffff;
  font-weight: 500;
}
</style>

